PORT=5000
NODE_ENV=development
# all: mọi request, compact: chỉ request chậm/lỗi, errors: chỉ 4xx/5xx, off: tắt completion log.
HTTP_LOG_MODE=compact
HTTP_SLOW_REQUEST_MS=2000
# Mặc định không log CORS preflight OPTIONS để tránh nhiễu terminal.
HTTP_LOG_OPTIONS=false
# Rate limit có thể điều chỉnh theo tải thực tế. API tính theo tài khoản + chi nhánh
# khi token hợp lệ; report có ngân sách riêng vì truy vấn tổng hợp tốn tài nguyên hơn.
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1200
REPORT_RATE_LIMIT_MAX=120
MONGO_URI=mongodb://mongo:27017/gym-management
# Bật true ở production để từ chối Mongo standalone và bắt buộc ACID đa document.
REQUIRE_MONGO_TRANSACTIONS=false
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, dùng HMAC mã cơ sở. Không commit giá trị thật.
FACILITY_LOOKUP_PEPPER=replace_with_a_random_secret_of_at_least_32_characters
INTERNAL_SERVICE_SECRET=replace_with_a_random_secret_of_at_least_32_characters
SEPAY_WEBHOOK_SECRET=replace_with_the_provider_webhook_secret
SEPAY_WEBHOOK_TOLERANCE_SECONDS=300

# CORS: Thêm domain production (phân cách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
BREVO_API_KEY=your_brevo_api_key

FACE_SERVICE_URL=http://localhost:5001
REDIS_URL=redis://localhost:6379
# Bật true khi production chạy nhiều instance để cấm fallback cache RAM cục bộ.
CACHE_REQUIRE_REDIS=false

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CENTRAL_DB_NAME=gympro_central
BRANCH_DB_PREFIX=gympro_branch_
DEFAULT_BRANCH_CODE=HN01
# Optional override. Trên Render, health endpoint tự dùng RENDER_GIT_COMMIT nếu biến này không được đặt.
RELEASE_SHA=development
